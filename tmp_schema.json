  /api/v1/enrollments/:
    get:
      operationId: v1_enrollments_list
      description: List all enrollments for the current user.
      parameters:
      - name: ordering
        required: false
        in: query
        description: Which field to use when ordering the results.
        schema:
          type: string
      - name: page
        required: false
        in: query
        description: A page number within the paginated result set.
        schema:
