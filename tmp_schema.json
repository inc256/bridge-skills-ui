              schema:
                $ref: '#/components/schemas/PaginatedEnrollmentList'
          description: ''
  /api/v1/enrollments/{enrollment_id}/progress/:
    get:
      operationId: v1_enrollments_progress_retrieve
      description: Get lesson-level progress for the current user within a course.
      summary: Get lesson progress list for an enrollment
      parameters:
      - in: path
        name: enrollment_id
        schema:
          type: string
          format: uuid
        required: true
      tags:
      - enrollments
      security:
      - jwtAuth: []
      responses:
        '200':
          content:
            application/json:
              schema:
                description: Lesson progress
          description: ''
  /api/v1/enrollments/{slug}/check/:
    get:
      operationId: v1_enrollments_check_retrieve
      description: Check if the current user is enrolled in a specific course.
      summary: Check enrollment status for a course
      parameters:
      - in: path
        name: slug
        schema:
          type: string
        required: true
      tags:
      - enrollments
      security:
      - jwtAuth: []
      responses:
        '200':
          content:
            application/json:
              schema:
