          multipart/form-data:
            schema:
              $ref: '#/components/schemas/AIGenerateRequest'
          application/x-www-form-urlencoded:
            schema:
              $ref: '#/components/schemas/AIGenerateRequest'
      security:
      - jwtAuth: []
      responses:
        '200':
          description: No response body
  /api/v1/ai/lesson/quiz/:
    post:
      operationId: v1_ai_lesson_quiz_create
