              $ref: '#/components/schemas/AIGenerateRequest'
          application/x-www-form-urlencoded:
            schema:
              $ref: '#/components/schemas/AIGenerateRequest'
      security:
      - jwtAuth: []
      responses:
        '200':
          description: No response body
  /api/v1/ai/course/reqs/:
    post:
      operationId: v1_ai_course_reqs_create
      summary: Generate course requirements
      tags:
