          description: ''
  /api/v1/enrollments/{slug}/enroll/:
    post:
      operationId: v1_enrollments_enroll_create
      description: Enroll in a free course.
      summary: Enroll in a free course
      parameters:
      - in: path
        name: slug
        schema:
          type: string
        required: true
      tags:
      - enrollments
