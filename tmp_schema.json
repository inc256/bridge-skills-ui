openapi: 3.0.3
info:
  title: TechBridge Skills Hub API
  version: 1.0.0
  description: |-
    Complete REST API for TechBridge Skills Hub e-learning platform.

    ## Authentication
    Use JWT tokens. Login at `/api/v1/auth/login/` to get `access` and `refresh` tokens.
    Include in requests: `Authorization: Bearer <access_token>`

    ## Base URL
    `/api/v1/`
paths:
  /api/v1/ai/chat/:
    post:
      operationId: v1_ai_chat_create
      summary: Free-form AI chat for instructors
      tags:
      - ai
      requestBody:
        content:
          application/json:
            schema:
              $ref: '#/components/schemas/AIGenerateRequest'
          multipart/form-data:
            schema:
              $ref: '#/components/schemas/AIGenerateRequest'
          application/x-www-form-urlencoded:
            schema:
              $ref: '#/components/schemas/AIGenerateRequest'
      security:
      - jwtAuth: []
      responses:
        '200':
          description: No response body
  /api/v1/ai/course/desc/:
    post:
      operationId: v1_ai_course_desc_create
      summary: Generate course description
      tags:
      - ai
      requestBody:
        content:
          application/json:
            schema:
              $ref: '#/components/schemas/AIGenerateRequest'
          multipart/form-data:
            schema:
              $ref: '#/components/schemas/AIGenerateRequest'
          application/x-www-form-urlencoded:
            schema:
              $ref: '#/components/schemas/AIGenerateRequest'
      security:
      - jwtAuth: []
      responses:
        '200':
          description: No response body
  /api/v1/ai/course/full/:
    post:
      operationId: v1_ai_course_full_create
      summary: Generate full course draft in one call
      tags:
      - ai
      requestBody:
        content:
          application/json:
            schema:
              $ref: '#/components/schemas/AIGenerateRequest'
          multipart/form-data:
