      responses:
        '200':
          description: Password changed
  /api/v1/auth/me/stats/:
    get:
      operationId: v1_auth_me_stats_retrieve
      description: Returns role-specific quick stats for the dashboard.
      summary: Dashboard stats for current user
      tags:
      - users
      security:
      - jwtAuth: []
      - {}
      responses:
        '200':
          description: No response body
  /api/v1/auth/register/:
    post:
      operationId: v1_auth_register_create
      description: Create a student or instructor account.
      summary: Register new user
      tags:
      - auth
      requestBody:
        content:
          application/json:
            schema:
              $ref: '#/components/schemas/RegisterRequest'
          multipart/form-data:
            schema:
              $ref: '#/components/schemas/RegisterRequest'
          application/x-www-form-urlencoded:
            schema:
              $ref: '#/components/schemas/RegisterRequest'
        required: true
      security:
      - jwtAuth: []
      - {}
      responses:
        '201':
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/User'
          description: ''
  /api/v1/auth/token/refresh/:
    post:
      operationId: v1_auth_token_refresh_create
      description: Pass a valid refresh token to receive a new access token. Returns
        401 if expired or user deleted.
      summary: Refresh JWT access token
      tags:
      - auth
      requestBody:
        content:
          application/json:
            schema:
              type: object
              properties:
                refresh:
                  type: string
              required:
              - refresh
      security:
      - jwtAuth: []
      - {}
      responses:
        '200':
          description: New access token issued
        '401':
          description: Token invalid or expired
  /api/v1/blog/:
    get:
      operationId: v1_blog_retrieve
      tags:
      - v1
      security:
      - jwtAuth: []
      - {}
      responses:
        '200':
          description: No response body
  /api/v1/blog/{slug}/:
    get:
      operationId: v1_blog_retrieve_2
      parameters:
      - in: path
        name: slug
        schema:
          type: string
        required: true
      tags:
      - v1
      security:
      - jwtAuth: []
      - {}
      responses:
        '200':
          description: No response body
  /api/v1/certificates/mine/:
    get:
      operationId: v1_certificates_mine_retrieve
      summary: Get my certificates
      tags:
      - certificates
      security:
      - jwtAuth: []
      - {}
      responses:
        '200':
          description: No response body
  /api/v1/certificates/verify/{number}/:
    get:
      operationId: v1_certificates_verify_retrieve
      summary: Verify a certificate by number
      parameters:
      - in: path
        name: number
        schema:
          type: string
        required: true
      tags:
      - certificates
      security:
      - jwtAuth: []
      - {}
      responses:
        '200':
          description: No response body
  /api/v1/courses/:
    get:
      operationId: v1_courses_list
      parameters:
      - in: query
        name: category__slug
        schema:
          type: string
      - in: query
        name: is_bestseller
        schema:
          type: boolean
      - in: query
        name: is_featured
        schema:
          type: boolean
      - in: query
        name: level
        schema:
          type: string
          enum:
          - advanced
          - beginner
          - intermediate
      - name: ordering
        required: false
        in: query
        description: Which field to use when ordering the results.
        schema:
          type: string
      - name: page
        required: false
        in: query
        description: A page number within the paginated result set.
        schema:
          type: integer
      - in: query
        name: pricing
        schema:
          type: string
          enum:
          - free
          - paid
          - subscription
      - name: search
        required: false
        in: query
        description: A search term.
        schema:
          type: string
      tags:
      - v1
      security:
      - jwtAuth: []
      - {}
      responses:
        '200':
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/PaginatedCourseListList'
          description: ''
  /api/v1/courses/{slug}/:
    get:
      operationId: v1_courses_retrieve
      summary: Get course details by slug
      parameters:
      - in: path
        name: slug
        schema:
          type: string
        required: true
      tags:
      - courses
      security:
      - jwtAuth: []
      responses:
        '200':
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/CourseDetail'
          description: ''
    put:
      operationId: v1_courses_update
      parameters:
      - in: path
        name: slug
        schema:
          type: string
        required: true
      tags:
      - v1
      requestBody:
        content:
          application/json:
            schema:
              $ref: '#/components/schemas/CourseCreateUpdateRequest'
          multipart/form-data:
            schema:
              $ref: '#/components/schemas/CourseCreateUpdateRequest'
          application/x-www-form-urlencoded:
            schema:
              $ref: '#/components/schemas/CourseCreateUpdateRequest'
        required: true
      security:
      - jwtAuth: []
      responses:
        '200':
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/CourseCreateUpdate'
          description: ''
    patch:
      operationId: v1_courses_partial_update
      summary: Update course
      parameters:
      - in: path
        name: slug
        schema:
          type: string
        required: true
      tags:
      - courses
      requestBody:
        content:
          application/json:
            schema:
              $ref: '#/components/schemas/PatchedCourseCreateUpdateRequest'
          multipart/form-data:
            schema:
              $ref: '#/components/schemas/PatchedCourseCreateUpdateRequest'
          application/x-www-form-urlencoded:
            schema:
              $ref: '#/components/schemas/PatchedCourseCreateUpdateRequest'
      security:
      - jwtAuth: []
      responses:
        '200':
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/CourseCreateUpdate'
          description: ''
    delete:
      operationId: v1_courses_destroy
      summary: Delete course
      parameters:
      - in: path
        name: slug
        schema:
          type: string
        required: true
      tags:
      - courses
      security:
      - jwtAuth: []
      responses:
        '204':
          description: No response body
  /api/v1/courses/{slug}/reviews/:
    get:
      operationId: v1_courses_reviews_list
      parameters:
      - name: ordering
        required: false
        in: query
        description: Which field to use when ordering the results.
        schema:
          type: string
      - name: page
        required: false
        in: query
        description: A page number within the paginated result set.
        schema:
          type: integer
      - name: search
        required: false
        in: query
        description: A search term.
        schema:
          type: string
      - in: path
        name: slug
        schema:
          type: string
        required: true
      tags:
      - v1
      security:
      - jwtAuth: []
      - {}
      responses:
        '200':
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/PaginatedCourseReviewList'
          description: ''
    post:
      operationId: v1_courses_reviews_create
      parameters:
      - in: path
        name: slug
        schema:
          type: string
        required: true
      tags:
      - v1
      requestBody:
        content:
          application/json:
            schema:
              $ref: '#/components/schemas/CourseReviewRequest'
          multipart/form-data:
            schema:
              $ref: '#/components/schemas/CourseReviewRequest'
          application/x-www-form-urlencoded:
            schema:
              $ref: '#/components/schemas/CourseReviewRequest'
        required: true
      security:
      - jwtAuth: []
      responses:
        '201':
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/CourseReview'
          description: ''
  /api/v1/courses/{slug}/wishlist/:
    post:
      operationId: v1_courses_wishlist_create
      summary: Toggle course in wishlist
      parameters:
      - in: path
        name: slug
        schema:
          type: string
        required: true
      tags:
      - courses
      security:
      - jwtAuth: []
      responses:
        '200':
          description: No response body
  /api/v1/courses/categories/:
    get:
      operationId: v1_courses_categories_list
      summary: List top-level categories
      parameters:
      - name: ordering
        required: false
        in: query
        description: Which field to use when ordering the results.
        schema:
          type: string
      - name: page
        required: false
        in: query
        description: A page number within the paginated result set.
        schema:
          type: integer
      - name: search
        required: false
        in: query
        description: A search term.
        schema:
          type: string
      tags:
      - courses
      security:
      - jwtAuth: []
      - {}
      responses:
        '200':
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/PaginatedCategoryList'
          description: ''
  /api/v1/courses/create/:
    post:
      operationId: v1_courses_create_create
      tags:
      - v1
      requestBody:
        content:
          application/json:
            schema:
              $ref: '#/components/schemas/CourseCreateUpdateRequest'
          multipart/form-data:
            schema:
              $ref: '#/components/schemas/CourseCreateUpdateRequest'
          application/x-www-form-urlencoded:
            schema:
              $ref: '#/components/schemas/CourseCreateUpdateRequest'
        required: true
      security:
      - jwtAuth: []
      responses:
        '201':
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/CourseCreateUpdate'
          description: ''
  /api/v1/courses/mine/:
    get:
      operationId: v1_courses_mine_list
      parameters:
      - name: ordering
        required: false
        in: query
        description: Which field to use when ordering the results.
        schema:
          type: string
      - name: page
        required: false
        in: query
        description: A page number within the paginated result set.
        schema:
          type: integer
      - name: search
        required: false
        in: query
        description: A search term.
        schema:
          type: string
      tags:
      - v1
      security:
      - jwtAuth: []
      responses:
        '200':
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/PaginatedCourseListList'
          description: ''
  /api/v1/courses/wishlist/:
    get:
      operationId: v1_courses_wishlist_list
      parameters:
      - name: ordering
        required: false
        in: query
        description: Which field to use when ordering the results.
        schema:
          type: string
      - name: page
        required: false
