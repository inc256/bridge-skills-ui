components:
  schemas:
    AIGenerateRequest:
      type: object
      description: Request body for all AI generation endpoints.
      properties:
        topic:
          type: string
          minLength: 1
          default: ''
        title:
          type: string
          minLength: 1
          default: ''
        description:
          type: string
          minLength: 1
          default: ''
        category:
          type: string
          minLength: 1
          default: ''
        level:
          type: string
          minLength: 1
          default: ''
        keywords:
          type: string
          minLength: 1
          default: ''
        lesson_title:
          type: string
          minLength: 1
          default: ''
        lesson_content:
          type: string
          minLength: 1
          default: ''
        section_title:
          type: string
          minLength: 1
          default: ''
        course_title:
          type: string
          minLength: 1
          default: ''
        num_sections:
          type: integer
          maximum: 12
          minimum: 2
          default: 5
        num_questions:
          type: integer
          maximum: 20
          minimum: 2
          default: 5
        target_audience:
          type: string
          minLength: 1
          default: ''
        message:
          type: string
          minLength: 1
          default: ''
        system:
          type: string
          minLength: 1
          default: ''
        provider:
          allOf:
          - $ref: '#/components/schemas/ProviderEnum'
          default: ''
        model:
          type: string
          minLength: 1
          default: ''
    AIResponse:
      type: object
      description: Standard AI response.
      properties:
        ok:
          type: boolean
        text:
          type: string
        provider:
          type: string
        model:
          type: string
        tokens:
          type: integer
        task:
          type: string
      required:
      - model
      - ok
      - provider
      - task
      - text
      - tokens
    Category:
      type: object
      properties:
        id:
          type: integer
          readOnly: true
        name:
          type: string
          maxLength: 80
        slug:
          type: string
          maxLength: 50
          pattern: ^[-a-zA-Z0-9_]+$
        description:
          type: string
        icon:
          type: string
          maxLength: 50
        image:
          type: string
          format: uri
          nullable: true
        display_order:
          type: integer
          maximum: 9223372036854775807
          minimum: 0
          format: int64
        is_featured:
          type: boolean
        parent:
          type: integer
          nullable: true
        children_count:
          type: integer
          readOnly: true
      required:
      - children_count
      - id
      - name
      - slug
    ChangePasswordRequest:
      type: object
      properties:
        old_password:
          type: string
          writeOnly: true
          minLength: 1
        new_password:
          type: string
          writeOnly: true
          minLength: 8
      required:
      - new_password
      - old_password
    CourseCreateUpdate:
      type: object
      description: Used for POST /courses/create/ and PATCH /courses/{slug}/.
      properties:
        title:
          type: string
          maxLength: 200
        slug:
          type: string
          maxLength: 220
          pattern: ^[-a-zA-Z0-9_]+$
        subtitle:
          type: string
          maxLength: 300
        description:
          type: string
        thumbnail:
          type: string
          format: uri
          nullable: true
        promo_video:
          oneOf:
          - type: string
            format: uri
            maxLength: 200
          - type: string
            maxLength: 0
        category:
          type: integer
          nullable: true
        level:
          $ref: '#/components/schemas/LevelEnum'
        language:
          type: string
          maxLength: 50
        status:
          $ref: '#/components/schemas/StatusDaeEnum'
        pricing:
          $ref: '#/components/schemas/PricingEnum'
        price:
          type: string
          format: decimal
          pattern: ^-?\d{0,8}(?:\.\d{0,2})?$
        sale_price:
          type: string
          format: decimal
          pattern: ^-?\d{0,8}(?:\.\d{0,2})?$
