      requestBody:
        content:
          application/json:
            schema:
              $ref: '#/components/schemas/AIGenerateRequest'
          multipart/form-data:
            schema:
              $ref: '#/components/schemas/AIGenerateRequest'
          application/x-www-form-urlencoded:
            schema:
              $ref: '#/components/schemas/AIGenerateRequest'
      security:
      - jwtAuth: []
      responses:
        '200':
          description: No response body
  /api/v1/ai/course/seo/:
    post:
      operationId: v1_ai_course_seo_create
      summary: Generate SEO keywords and meta description
      tags:
