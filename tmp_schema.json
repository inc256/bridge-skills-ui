      responses:
        '200':
          description: No response body
  /api/v1/ai/course/outcomes/:
    post:
      operationId: v1_ai_course_outcomes_create
      summary: Generate learning outcomes
      tags:
      - ai
      requestBody:
        content:
          application/json:
            schema:
              $ref: '#/components/schemas/AIGenerateRequest'
          multipart/form-data:
            schema:
